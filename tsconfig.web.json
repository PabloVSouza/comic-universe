{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/env.d.ts", "src/**/*", "src/**/*.tsx", "src/@types/*.d.ts", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "main/*": ["./src/electron/main/*"],
      "preload/*": ["./src/electron/preload/*"],
      "repositories/*": ["./src/electron/repositories/*"],
      "scripts/*": ["./src/electron/scripts/*"],
      "database/*": ["./src/database/*"],
      "assets": ["./src/renderer/assets/index"],
      "assets/*": ["./src/renderer/assets/*"],
      "components/*": ["./src/renderer/components/*"],
      "electron/*": ["./src/renderer/electron/*"],
      "hooks": ["./src/renderer/hooks/index"],
      "hooks/*": ["./src/renderer/hooks/*"],
      "layouts/*": ["./src/renderer/layouts/*"],
      "windows/*": ["./src/renderer/windows/*"],
      "lang/*": ["./src/renderer/lang/*"],
      "functions/*": ["./src/renderer/functions/*"],
      "routes/*": ["./src/renderer/routes/*"],
      "css/*": ["./src/renderer/css/*"],
      "store/*": ["./src/renderer/store/*"],
      "constants/*": ["./src/renderer/constants/*"],
      "@types/*": ["./src/renderer/@types/*"],
      "shared/*": ["./src/shared/*"],
      "electron-utils": ["./src/electron/utils/index"],
      "electron-utils/*": ["./src/electron/utils/*"],
      "renderer-utils": ["./src/renderer/utils/index"],
      "renderer-utils/*": ["./src/renderer/utils/*"],
      "i18n": ["./src/renderer/i18n/index"],
      "i18n/*": ["./src/renderer/i18n/*"],
      "*": ["./src/renderer/*"]
    }
  }
}
